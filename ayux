<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayutuxtepeque - Historia Viva</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Raleway:wght@300;400;600&family=Merriweather:wght@300;400;700&family=Open+Sans:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #1E3A8A;
            --secondary: #3B82F6;
            --accent: #60A5FA;
            --light: #F0F9FF;
            --dark: #1E3A8A;
            --text: #1E40AF;
            --transition: all 0.4s ease;
        }

        body {
            background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%);
            color: var(--text);
            line-height: 1.7;
            font-family: 'Open Sans', sans-serif;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header Compacto */
        .compact-header {
            background: var(--dark);
            padding: 15px 0;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-img {
            height: 50px;
            width: auto;
            border-radius: 8px;
            object-fit: cover;
            animation: pulse 3s infinite alternate;
        }

        .logo {
            color: white;
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            text-decoration: none;
        }

        .logo span {
            color: var(--accent);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-family: 'Raleway', sans-serif;
            font-weight: 500;
            transition: var(--transition);
            position: relative;
        }

        .nav-links a:hover {
            color: var(--accent);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent);
            transition: var(--transition);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Hero Section Minimalista */
        .minimal-hero {
            background: linear-gradient(135deg, var(--primary) 0%, #2563EB 100%);
            color: white;
            padding: 150px 0 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .minimal-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" fill="%23ffffff" opacity="0.1"><polygon points="1000,100 1000,0 0,100"/></svg>');
            background-size: cover;
            animation: wave 15s linear infinite;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            margin: 0 auto;
        }

        .hero-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            margin-bottom: 20px;
            animation: fadeInUp 1s ease, titleGlow 3s ease-in-out infinite alternate;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
            position: relative;
        }

        .hero-content p {
            font-family: 'Raleway', sans-serif;
            font-size: 1.3rem;
            margin-bottom: 30px;
            animation: fadeInUp 1.2s ease;
        }

        /* Secciones */
        section {
            padding: 80px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
            font-family: 'Merriweather', serif;
            font-size: 2.5rem;
            color: var(--dark);
            position: relative;
            animation: slideInFromLeft 1s ease-out;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            margin: 15px auto;
            border-radius: 2px;
            transition: var(--transition);
        }

        .section-title:hover::after {
            width: 120px;
            background: linear-gradient(90deg, var(--accent), var(--primary));
        }

        /* About Section Mejorada */
        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
            margin-bottom: 60px;
        }

        .about-text {
            font-family: 'Open Sans', sans-serif;
        }

        .about-text p {
            margin-bottom: 20px;
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 30px;
        }

        .stat-item {
            text-align: center;
            padding: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: var(--transition);
        }

        .stat-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 5px;
        }

        /* MODIFICACIÓN: Contenedor de imagen ajustable */
        .about-image {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            width: 100%;
            height: auto;
            animation: float 6s ease-in-out infinite;
        }

        .about-image img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .about-image:hover img {
            transform: scale(1.05);
        }

        .image-placeholder {
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, var(--secondary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Raleway', sans-serif;
            font-weight: 600;
        }

        /* Timeline Mejorado con Imágenes */
        .timeline-section {
            background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
        }

        .modern-timeline {
            position: relative;
            max-width: 1000px;
            margin: 0 auto;
        }

        .timeline-item {
            display: flex;
            margin-bottom: 60px;
            position: relative;
            opacity: 0;
            transform: translateX(-50px);
            transition: all 0.6s ease;
        }

        .timeline-item.visible {
            opacity: 1;
            transform: translateX(0);
        }

        .timeline-item:nth-child(even) {
            transform: translateX(50px);
        }

        .timeline-item:nth-child(even).visible {
            transform: translateX(0);
        }

        .timeline-content {
            flex: 1;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            position: relative;
            border-left: 4px solid var(--primary);
            transition: var(--transition);
        }

        .timeline-content:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

        .timeline-image {
            flex: 0 0 300px;
            height: 200px;
            margin: 0 30px;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            position: relative;
            transition: var(--transition);
        }

        .timeline-image:hover {
            transform: scale(1.03);
        }

        .timeline-image .image-placeholder {
            height: 100%;
        }

        .timeline-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .timeline-image:hover img {
            transform: scale(1.1);
        }

        .timeline-date {
            font-family: 'Merriweather', serif;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 1.2rem;
        }

        /* Cultura Interactiva */
        #cultura {
            background: linear-gradient(135deg, #F0F9FF 0%, #DBEAFE 100%);
        }

        .culture-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .culture-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: var(--transition);
            position: relative;
            animation: float 6s ease-in-out infinite;
        }

        .culture-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        }

        .culture-image {
            height: 200px;
            background: linear-gradient(45deg, var(--secondary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Raleway', sans-serif;
            font-weight: 600;
            overflow: hidden;
            position: relative;
        }

        .culture-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.2);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .culture-card:hover .culture-image::before {
            opacity: 1;
        }

        .culture-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .culture-card:hover .culture-image img {
            transform: scale(1.1);
        }

        .culture-content {
            padding: 25px;
        }

        .culture-content h3 {
            font-family: 'Playfair Display', serif;
            color: #1E3A8A;
            margin-bottom: 15px;
            font-size: 1.4rem;
        }

        .culture-content p {
            color: #1E40AF;
            line-height: 1.7;
            font-size: 1rem;
        }

        /* Galería Interactiva Mejorada */
        .interactive-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .gallery-item {
            height: 200px;
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            animation: float 8s ease-in-out infinite;
        }

        .gallery-item:nth-child(2) {
            animation-delay: 1s;
        }

        .gallery-item:nth-child(3) {
            animation-delay: 2s;
        }

        .gallery-item:nth-child(4) {
            animation-delay: 3s;
        }

        .gallery-item:hover {
            transform: scale(1.05);
            animation-play-state: paused;
        }

        .gallery-item .image-placeholder {
            height: 100%;
            position: relative;
            overflow: hidden;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        /* Modal para Galería */
        .modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.9);
            animation: fadeIn 0.3s;
        }

        .modal-content {
            position: relative;
            margin: 5% auto;
            padding: 20px;
            width: 80%;
            max-width: 800px;
            animation: zoomIn 0.4s;
        }

        .modal-image {
            width: 100%;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .modal-info {
            background: white;
            padding: 20px;
            border-radius: 0 0 10px 10px;
            margin-top: -5px;
        }

        .modal-info h3 {
            font-family: 'Playfair Display', serif;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .close {
            position: absolute;
            top: 15px;
            right: 35px;
            color: white;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
            transition: var(--transition);
        }

        .close:hover {
            color: var(--accent);
            transform: scale(1.1);
        }

        /* Mapa Section - REDUCIDO */
        .map-section {
            background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
        }

        .map-container {
            height: 400px; /* Aumentado ligeramente para mejor visualización del mapa */
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            margin-top: 30px;
        }

        #map {
            width: 100%;
            height: 100%;
            border-radius: 15px;
        }

        /* Footer Compacto */
        .compact-footer {
            background: var(--dark);
            color: white;
            padding: 40px 0 20px;
            text-align: center;
        }

        .footer-content {
            margin-bottom: 30px;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin: 20px 0;
        }

        .footer-links a {
            color: var(--accent);
            text-decoration: none;
            transition: var(--transition);
        }

        .footer-links a:hover {
            color: white;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 20px 0;
        }

        .social-links a {
            color: white;
            font-size: 1.3rem;
            transition: var(--transition);
        }

        .social-links a:hover {
            color: var(--accent);
            transform: translateY(-3px);
        }

        .copyright {
            font-family: 'Raleway', sans-serif;
            font-size: 0.9rem;
            color: var(--accent);
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        /* Nuevas Animaciones para Títulos */
        @keyframes titleGlow {
            0% {
                text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
            }
            100% {
                text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(96, 165, 250, 0.6);
            }
        }

        @keyframes slideInFromLeft {
            0% {
                transform: translateX(-100px);
                opacity: 0;
            }
            100% {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes bounceIn {
            0% {
                transform: scale(0.3);
                opacity: 0;
            }
            50% {
                transform: scale(1.05);
            }
            70% {
                transform: scale(0.9);
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @keyframes typewriter {
            from {
                width: 0;
            }
            to {
                width: 100%;
            }
        }

        /* MODIFICACIÓN: Eliminada la animación blinkCursor ya que no se usa */
        
        /* Efecto de máquina de escribir para el título principal - MODIFICADO */
        .typewriter {
            overflow: hidden;
            white-space: nowrap;
            margin: 0 auto;
            animation: typewriter 3.5s steps(40, end);
        }

        /* Efectos adicionales para títulos */
        .animated-title {
            animation: rainbowText 4s infinite, shake 0.5s ease-in-out 3.5s;
        }

        .wave-letters {
            display: inline-block;
        }

        .wave-letters span {
            display: inline-block;
            animation: letterWave 2s infinite;
        }

        .wave-letters span:nth-child(2) { animation-delay: 0.1s; }
        .wave-letters span:nth-child(3) { animation-delay: 0.2s; }
        .wave-letters span:nth-child(4) { animation-delay: 0.3s; }
        .wave-letters span:nth-child(5) { animation-delay: 0.4s; }
        .wave-letters span:nth-child(6) { animation-delay: 0.5s; }
        .wave-letters span:nth-child(7) { animation-delay: 0.6s; }
        .wave-letters span:nth-child(8) { animation-delay: 0.7s; }
        .wave-letters span:nth-child(9) { animation-delay: 0.8s; }
        .wave-letters span:nth-child(10) { animation-delay: 0.9s; }
        .wave-letters span:nth-child(11) { animation-delay: 1.0s; }
        .wave-letters span:nth-child(12) { animation-delay: 1.1s; }
        .wave-letters span:nth-child(13) { animation-delay: 1.2s; }
        .wave-letters span:nth-child(14) { animation-delay: 1.3s; }
        .wave-letters span:nth-child(15) { animation-delay: 1.4s; }
        .wave-letters span:nth-child(16) { animation-delay: 1.5s; }
        .wave-letters span:nth-child(17) { animation-delay: 1.6s; }
        .wave-letters span:nth-child(18) { animation-delay: 1.7s; }
        .wave-letters span:nth-child(19) { animation-delay: 1.8s; }
        .wave-letters span:nth-child(20) { animation-delay: 1.9s; }
        .wave-letters span:nth-child(21) { animation-delay: 2.0s; }
        .wave-letters span:nth-child(22) { animation-delay: 2.1s; }
        .wave-letters span:nth-child(23) { animation-delay: 2.2s; }
        .wave-letters span:nth-child(24) { animation-delay: 2.3s; }
        .wave-letters span:nth-child(25) { animation-delay: 2.4s; }

        /* Animaciones Existentes */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from {opacity: 0;}
            to {opacity: 1;}
        }

        @keyframes zoomIn {
            from {transform: scale(0.8); opacity: 0;}
            to {transform: scale(1); opacity: 1;}
        }

        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-10px);
            }
            100% {
                transform: translateY(0px);
            }
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.02);
            }
            100% {
                transform: scale(1);
            }
        }

        @keyframes wave {
            0% {
                transform: translateX(0) translateY(0);
            }
            50% {
                transform: translateX(-10px) translateY(-5px);
            }
            100% {
                transform: translateX(0) translateY(0);
            }
        }

        /* Nuevos efectos adicionales */
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @keyframes flipIn {
            0% {
                transform: rotateX(90deg);
                opacity: 0;
            }
            100% {
                transform: rotateX(0);
                opacity: 1;
            }
        }

        @keyframes neonGlow {
            0%, 100% {
                text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 15px var(--accent), 0 0 20px var(--accent);
            }
            50% {
                text-shadow: 0 0 10px #fff, 0 0 20px #fff, 0 0 30px var(--accent), 0 0 40px var(--accent);
            }
        }

        @keyframes slideInFromTop {
            0% {
                transform: translateY(-100px);
                opacity: 0;
            }
            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* Efectos de partículas */
        .particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 50%;
            animation: floatParticle 15s infinite linear;
        }

        @keyframes floatParticle {
            0% {
                transform: translateY(0) translateX(0);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) translateX(100px);
                opacity: 0;
            }
        }

        /* Efectos mejorados para títulos centrados */
        .centered-title {
            text-align: center;
            margin: 0 auto 50px;
            display: block;
            width: 100%;
        }

        .enhanced-title {
            position: relative;
            display: inline-block;
            padding: 10px 30px;
            background: linear-gradient(45deg, var(--primary), var(--accent));
            background-size: 200% 200%;
            animation: gradientShift 5s ease infinite;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .enhanced-title::before {
            content: '';
            position: absolute;
            top: -5px;
            left: -5px;
            right: -5px;
            bottom: -5px;
            background: linear-gradient(45deg, var(--primary), var(--accent), var(--primary));
            border-radius: 15px;
            z-index: -1;
            opacity: 0.3;
            animation: gradientShift 5s ease infinite;
        }

        /* Nuevos efectos para títulos */
        @keyframes rainbowText {
            0% { color: #1E3A8A; }
            25% { color: #3B82F6; }
            50% { color: #60A5FA; }
            75% { color: #3B82F6; }
            100% { color: #1E3A8A; }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
            20%, 40%, 60%, 80% { transform: translateX(5px); }
        }

        @keyframes rotate3D {
            0% { transform: perspective(1000px) rotateY(0deg); }
            100% { transform: perspective(1000px) rotateY(360deg); }
        }

        @keyframes letterWave {
            0%, 100% { transform: translateY(0); }
            25% { transform: translateY(-10px); }
            50% { transform: translateY(0); }
            75% { transform: translateY(5px); }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .about-grid {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .timeline-item {
                flex-direction: column;
            }

            .timeline-image {
                flex: none;
